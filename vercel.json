{
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "tanstack-start",
      "routePrefix": "/"
    },
    "backend": {
      "root": "backend/",
      "framework": "fastapi",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "source": "/((?!api).*)*",
      "destination": {
        "service": "frontend",
        "path": "index.html"
      }
    }
  ]
}